<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08090D">

    <LinearLayout
        android:id="@+id/mainContent"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:text="HM"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="MUSIC PLAYER  •  V2"
            android:textColor="#777D8D"
            android:textSize="10sp"
            android:letterSpacing="0.25"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/search"
            android:hint="Search songs, artists or albums"
            android:textColor="#FFFFFF"
            android:textColorHint="#6E7482"
            android:singleLine="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:backgroundTint="#292D38"
            android:layout_marginTop="22dp"
            android:layout_width="match_parent"
            android:layout_height="54dp"/>

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="YOUR MUSIC"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="ALL"
                android:textColor="#858A99"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <ListView
            android:id="@+id/songList"
            android:divider="#151821"
            android:dividerHeight="1dp"
            android:paddingTop="10dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:background="#141720"
            android:layout_width="match_parent"
            android:layout_height="90dp">

            <TextView
                android:text="NOW PLAYING"
                android:textColor="#747B8B"
                android:textSize="9sp"
                android:letterSpacing="0.20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Select a song"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="••••••••••••••••••••"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loading"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#08090D"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:text="HM"
            android:textColor="#FFFFFF"
            android:textSize="72sp"
            android:textStyle="bold"
            android:letterSpacing="0.20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="MUSIC PLAYER"
            android:textColor="#858A99"
            android:textSize="12sp"
            android:letterSpacing="0.32"
            android:layout_marginTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ProgressBar
            android:indeterminate="true"
            android:layout_marginTop="28dp"
            android:layout_width="30dp"
            android:layout_height="30dp"/>
    </LinearLayout>
</FrameLayout>
