<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#08090D">
    <LinearLayout android:id="@+id/mainContent" android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:text="HM" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" android:letterSpacing="0.14" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="MUSIC PLAYER" android:textColor="#858A99" android:textSize="11sp" android:letterSpacing="0.24" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/search" android:hint="Search music" android:textColor="#FFFFFF" android:textColorHint="#747986" android:singleLine="true" android:paddingStart="16dp" android:paddingEnd="16dp" android:backgroundTint="#30333E" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="52dp"/>
        <TextView android:text="Your music" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="22dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <ListView android:id="@+id/songList" android:divider="@android:color/transparent" android:dividerHeight="8dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/loading" android:orientation="vertical" android:gravity="center" android:background="#08090D" android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:text="HM" android:textColor="#FFFFFF" android:textSize="68sp" android:textStyle="bold" android:letterSpacing="0.18" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="MUSIC PLAYER" android:textColor="#858A99" android:textSize="12sp" android:letterSpacing="0.30" android:layout_marginTop="5dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <ProgressBar android:indeterminate="true" android:layout_marginTop="26dp" android:layout_width="32dp" android:layout_height="32dp"/>
    </LinearLayout>
</FrameLayout>
